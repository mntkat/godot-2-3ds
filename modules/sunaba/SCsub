#!/usr/bin/env python

Import('env')
Import('env_modules')

env_sunaba = env_modules.Clone()

# Lua 5.4 (thirdparty/lua). Built as C: Lua errors use longjmp, so the
# bindings never let a Lua error cross live C++ objects (see lua_bridge.h).
thirdparty_dir = "#thirdparty/lua/"
thirdparty_sources = [
    "lapi.c", "lauxlib.c", "lbaselib.c", "lcode.c", "lcorolib.c", "lctype.c",
    "ldblib.c", "ldebug.c", "ldo.c", "ldump.c", "lfunc.c", "lgc.c", "linit.c",
    "liolib.c", "llex.c", "lmathlib.c", "lmem.c", "loadlib.c", "lobject.c",
    "lopcodes.c", "loslib.c", "lparser.c", "lstate.c", "lstring.c", "lstrlib.c",
    "ltable.c", "ltablib.c", "ltm.c", "lundump.c", "lutf8lib.c", "lvm.c", "lzio.c",
]
thirdparty_sources = [thirdparty_dir + f for f in thirdparty_sources]

env_sunaba.Append(CPPPATH=[thirdparty_dir])

if env["platform"] in ["x11", "server", "osx", "haiku"]:
    # POSIX popen (io.popen) and mkstemp (os.tmpname).
    env_sunaba.Append(CPPFLAGS=["-DLUA_USE_POSIX"])

env_sunaba.add_source_files(env.modules_sources, thirdparty_sources)
env_sunaba.add_source_files(env.modules_sources, "*.cpp")

Export('env')
